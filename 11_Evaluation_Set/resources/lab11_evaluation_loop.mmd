%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 30, "rankSpacing": 50, "wrappingWidth": 420, "htmlLabels": true}, "markdownAutoWrap": false, "themeVariables": {"fontFamily": "IBM Plex Mono, monospace", "fontSize": "15px", "primaryColor": "#FFFFFF", "primaryBorderColor": "#0B1220", "primaryTextColor": "#0B1220", "lineColor": "#6B7383", "clusterBkg": "#F4F5F7", "clusterBorder": "#6B7383"}}}%%
%% Lab 11: one case scored three ways, then compared case by case.
%% Export: npx -y @mermaid-js/mermaid-cli -i lab11_evaluation_loop.mmd -o lab11_evaluation_loop.png -b white -s 2
flowchart LR
    subgraph cases["five cases"]
        saved["saved reply<br/>gpt-6-luna, 5 Oct 2026"]
        live["your copilot's reply<br/>same input, run now"]
    end
    case["case<br/>input · reply<br/>received files · want"]
    label["your label<br/>written first"]
    code["code checks<br/>citations · digits · planted string<br/>+ reference: expected files"]
    judge["judge<br/>rubric · structured verdict<br/>a model call"]
    table["one row per case<br/>code · judge · label<br/>seconds · cost"]
    saved --> case
    live --> case
    case --> label
    case --> code
    case --> judge
    label --> table
    code --> table
    judge --> table
    classDef first fill:#C9F24D,stroke:#0B1220,color:#0B1220
    classDef out fill:#0B1220,stroke:#0B1220,color:#FFFFFF
    class label first
    class table out
