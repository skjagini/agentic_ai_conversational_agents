%% Lab 05: build the index once, then search it for every question.
%% Export: npx -y @mermaid-js/mermaid-cli -i lab05_index_and_search.mmd -o lab05_index_and_search.png -b white -s 2
flowchart TB
    subgraph ONCE["Once, when the handbook changes (Parts C and D)"]
        direction LR
        H["support_handbook.md<br>20 policies"] --> SP["split by heading<br>20 chunks + source file"]
        SP --> E1["embed each chunk<br>EMBED_MODEL"]
        E1 --> N1["normalise<br>length 1"]
        N1 --> I[("IndexFlatIP<br>20 vectors")]
        SP --> J["chunks.json<br>text + source"]
    end

    subgraph EVERY["For every question (Parts E and F)"]
        direction LR
        Q(["rep's question"]) --> E2["embed<br>same model"]
        E2 --> N2["normalise"]
        N2 --> S["search, k = 3<br>compare with all 20"]
        S --> R(["top 3 chunks + cosine scores<br>always 3, covered or not"])
    end

    I --> S
    J --> R

    style R fill:#C9F24D,stroke:#0B1220
    style Q fill:#0B1220,color:#FFFFFF
    style H fill:#0B1220,color:#FFFFFF
