%% Lab 04: short-term memory (a thread, saved by the checkpointer) and long-term memory (a store, written by a tool).
%% Export: npx -y @mermaid-js/mermaid-cli -i lab04_two_memories.mmd -o lab04_two_memories.png -b white -s 2
flowchart LR
    subgraph ST["Short-term: one thread"]
        T1["thread-A<br/>every message"] --> CK["checkpointer<br/>a checkpoint per step"]
    end
    subgraph LT["Long-term: every thread of one rep"]
        TOOL["save_preference tool<br/>runtime.store.put"] --> ST1[("store<br/>namespace<br/>('rep','rep-42')<br/>reply_format<br/>sign_off")]
        ST1 --> DP["@dynamic_prompt<br/>reads the rep's memories<br/>before every model call"]
    end
    T1 -. "rep: 'write replies as<br/>three bullet points'" .-> TOOL
    DP --> T2["rep 42's<br/>new threads"]
    CTX["context: rep_id<br/>from the sign-in,<br/>never from the model"] --> TOOL
    CTX --> DP
