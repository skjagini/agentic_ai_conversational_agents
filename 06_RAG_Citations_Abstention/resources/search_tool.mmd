%% Lab 08: two ways to answer from the handbook, and the checks your code runs on every answer.
%% Export: npx -y @mermaid-js/mermaid-cli -i search_tool.mmd -o search_tool.png -b white -s 2
flowchart TB
    Q(["rep's question"])

    subgraph TWO["Two steps (Part B): your code always searches"]
        S1["your code: search(question)<br>4 passages with their files"] --> M1["model, 1 call:<br>prompt + passages + question"]
    end

    subgraph AGENT["Search as a tool (Parts C to E): the model decides"]
        M2{"model, call 1:<br>does the question<br>need the handbook?"} -- yes --> T["your code runs search_policies(query):<br>passages for the model,<br>files and scores as the artifact"]
        T --> M3["model, call 2:<br>answers from the passages"]
        M2 -- no --> D(["answers directly, no search"])
    end

    Q --> S1
    Q --> M2
    M1 --> A(["answer citing [policy_*.md],<br>or: the handbook does not cover it"])
    M3 --> A
    A --> K["checks in your code (Parts F and G)<br>cited files were retrieved<br>abstains when no policy answers<br>each quote is in its passage"]

    style K fill:#C9F24D,stroke:#0B1220
    style Q fill:#0B1220,color:#FFFFFF
    style A fill:#0B1220,color:#FFFFFF
    style D fill:#0B1220,color:#FFFFFF
