%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 30, "rankSpacing": 40}, "themeVariables": {"fontFamily": "IBM Plex Mono, monospace", "fontSize": "15px", "primaryColor": "#FFFFFF", "primaryBorderColor": "#0B1220", "primaryTextColor": "#0B1220", "lineColor": "#6B7383", "clusterBkg": "#F4F5F7", "clusterBorder": "#6B7383"}}}%%
%% Lab 09: who decides the next step in a chain, a router and an agent.
%% Export: npx -y @mermaid-js/mermaid-cli -i lab09_three_shapes.mmd -o lab09_three_shapes.png -b white -s 2
flowchart TB
    subgraph CHAIN["chain: your code fixes every step"]
        direction LR
        c1[extract<br/>model] --> c2[fetch<br/>code] --> c3[rule<br/>code] --> c4[draft<br/>model]
    end
    subgraph ROUTER["router: the model picks one label, your code picks the path"]
        direction LR
        r0[classify<br/>model] -->|policy_question| r1[policy agent]
        r0 -->|account_lookup| r2[account agent]
        r0 -->|refund_request| r3[refund agent<br/>+ approval]
        r0 -->|out_of_scope| r4[fixed reply<br/>no model]
    end
    subgraph AGENT["agent: the model picks every next step"]
        direction LR
        a0[model] -->|tool call| a1[any of 5 tools]
        a1 -->|result| a0
        a0 -->|no tool call| a2[reply]
    end
    CHAIN ~~~ ROUTER ~~~ AGENT
    classDef model fill:#0B1220,color:#FFFFFF,stroke:#0B1220
    classDef code fill:#C9F24D,color:#0B1220,stroke:#0B1220
    class c1,c4,r0,a0 model
    class c2,c3,r4 code
