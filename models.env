# Model settings for every lab. Change a model here, once, and every notebook picks it up.
# This file is committed and holds no secrets. Keys go in .env (local) or Colab Secrets.
# A value set in .env or in the environment overrides the one here.

# Chat model for the copilot (all labs)
CHAT_MODEL=gpt-4o-mini

# Reasoning effort: leave empty for models without it (gpt-4o-mini).
# Set to none, low, medium or high only for a reasoning model.
REASONING_EFFORT=

# Reasoning model for the optional reasoning-effort demo in Lab 11's Going further (the only lab that reads it).
# Empty by default, so Run All skips the paid demo; Lab 11's text keeps our results from gpt-5.
# To run it, set a reasoning model your account allows (here or in .env) and its prices below.
# gpt-5 accepts reasoning effort minimal, low, medium or high; the demo uses low, medium and high.
# The dated snapshot behind gpt-5 (gpt-5-2025-08-07) retires on 11 Dec 2026 (OpenAI deprecations page,
# checked 12 Oct 2026): choose its replacement and its prices here before then.
REASONING_MODEL=
# Its prices in US dollars per 1M tokens, checked 12 Oct 2026 at /api/docs/pricing. Reasoning tokens are billed as output.
REASONING_PRICE_INPUT=1.25
REASONING_PRICE_CACHED_INPUT=0.125
REASONING_PRICE_OUTPUT=10.00

# Judge model for Lab 10. A different, stronger model is better when one is allowed.
JUDGE_MODEL=gpt-4o-mini

# Fallback model for Lab 12: the model the copilot switches to when CHAT_MODEL keeps failing.
# A different model or provider is better; with one allowed model it is the same model.
FALLBACK_MODEL=gpt-4o-mini

# Embeddings (Lab 07, and the handbook search from Lab 08 on) and moderation (Lab 12)
EMBED_MODEL=text-embedding-3-small
MODERATION_MODEL=omni-moderation-latest

# Prices in US dollars per 1M tokens, for the cost labs (Lab 11 prices every call with them). Update them with the model.
# Checked 10 Oct 2026 at developers.openai.com/api/docs/models; checked again 12 Oct 2026 at /api/docs/pricing.
CHAT_PRICE_INPUT=0.15
CHAT_PRICE_CACHED_INPUT=0.075
# Cache writes: gpt-4o-mini adds no charge for them (they cost the input price). GPT-5.6 and later charge 1.25x
# input (for example gpt-6-luna: input 0.10, cached 0.01, cache write 0.125, output 0.50). OpenAI reports them as
# cache_write_tokens (LangChain: cache_creation); on gpt-4o-mini there are none. Lab 11 reads this line.
CHAT_PRICE_CACHE_WRITE=0.15
CHAT_PRICE_OUTPUT=0.60
JUDGE_PRICE_INPUT=0.15
JUDGE_PRICE_OUTPUT=0.60
EMBED_PRICE_INPUT=0.02
